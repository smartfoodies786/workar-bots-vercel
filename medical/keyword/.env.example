# Medical Clinic WhatsApp bot — KEYWORD variant
# Copy to .env locally, or set the same names in Vercel env vars.
# All values below are placeholders / the original demo values — no real keys.

# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Clinic Info (change per client) ─────────────────────────
CLINIC_NAME=HealthFirst Medical Clinic
CLINIC_ADDRESS=123 Health Street, New York, NY 10001
CLINIC_PHONE=+1 (555) 901-2345
CLINIC_EMAIL=info@healthfirst.com
CLINIC_WEBSITE=https://healthfirst.com
CLINIC_HOURS=Mon–Fri: 8am–5pm | Sat: 9am–1pm | Sun: Closed
GOOGLE_MAPS=https://maps.google.com/?q=healthfirst
PARKING=Free parking available in our lot
NEAREST_ER=NewYork-Presbyterian Hospital
NURSE_LINE=+1 (555) 901-9999

# ── Patient Portal ───────────────────────────────────────────
PATIENT_PORTAL=https://portal.healthfirst.com
GOOGLE_REVIEW=https://g.page/r/healthfirst/review

# ── Doctors ──────────────────────────────────────────────────
DOCTOR_1=Sarah Johnson
SPEC_1=General Practice / Family Medicine
DOCTOR_2=Michael Chen
SPEC_2=Internal Medicine
DOCTOR_3=Emily Williams
SPEC_3=Pediatrics

# ── Insurance ────────────────────────────────────────────────
INSURANCE_LIST=Blue Cross Blue Shield, Aetna, Cigna, United Healthcare, Medicare, Medicaid

# ── Appointment Fees ─────────────────────────────────────────
FEE_NEW=$150
FEE_FU=$80
FEE_PHY=$120
FEE_URG=$100
FEE_VAC=$50
FEE_LAB=$60
FEE_TEL=$75
FEE_MH=$130

# ── Hours (24hr) ─────────────────────────────────────────────
OPEN_HOUR=8
CLOSE_HOUR=17

# ── Owner/Staff ──────────────────────────────────────────────
OWNER_PHONE=+923366614025

# ── Server (local only) ──────────────────────────────────────
PORT=3000

# ── Supabase (persistence — BOTH variants) ───────────────────
# If SUPABASE_URL + key are not set, the bot falls back to in-memory
# Maps for demo only and logs "demo mode: in-memory, data lost on restart".
# Run supabase-schema.sql in the Supabase SQL Editor to create the tables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # optional, server-side only if used

# ── AI ───────────────────────────────────────────────────────
# NONE in this variant. This keyword variant needs no AI key at all.
# (The AI variant adds GROQ_API_KEY / GEMINI_API_KEY.)
