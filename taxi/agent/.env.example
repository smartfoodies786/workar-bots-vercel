# Airport Transfer Taxi WhatsApp AGENT — .env.example
# Copy to .env and fill in the secrets. NEVER commit a real .env.
# The contact values below are the site's PUBLISHED details — use exactly.
# This is the Level 3 AGENT variant: lib/agent.js tool-calling loop
# (Groq first, Gemini fallback) + deterministic tool router in the same
# file. Without an AI key the LLM loop is skipped and the router + keyword
# flow handle messages — the agent never crashes on a missing key.

# Business (published on gatwicktransfertaxi.co.uk — not secrets)
BUSINESS_NAME="Airport Transfer Taxi"
SITE=https://gatwicktransfertaxi.co.uk
CONTACT_PHONE=+447541159964
CONTACT_EMAIL=bookings@gatwicktransfertaxi.co.uk
OWNER_PHONE=+447541159964

# Twilio WhatsApp (from the Twilio console — secrets, keep out of git)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Supabase (from the Supabase project settings — keep out of git)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Testing only: TWILIO_MOCK=true logs the exact owner WhatsApp message
# instead of sending it. Never send a real WhatsApp during local tests.
TWILIO_MOCK=true

# AI variant only (add in Vercel env vars, never in chat or git)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NOTE: GROK_API_KEY is accepted as a spelling alias for GROQ_API_KEY.
# Groq is the intended provider (free tier, model gpt-oss-20b) — NOT xAI Grok.
# The AGENT uses these keys for its tool-calling loop; without them the
# deterministic tool router still runs the same tools locally.
