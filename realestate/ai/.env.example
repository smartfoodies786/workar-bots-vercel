# Real Estate WhatsApp Bot — AI variant
# Placeholders only. No real keys/secrets in this file.
# Nabil: add GROQ_API_KEY (and optionally GEMINI_API_KEY) yourself directly
# in Vercel env vars — never paste keys in chat or in files.

# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Free APIs ────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key
FRED_API_KEY=your_fred_key_from_fred.stlouisfed.org

# ── AI (free tiers; Groq first, Gemini fallback) ─────────────
# GROK_API_KEY is also accepted as a spelling fallback for GROQ_API_KEY.
# It means Groq (free tier, model gpt-oss-20b) — NOT xAI Grok. No xAI API is called.
GROQ_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=

# ── Supabase (optional — without these, demo in-memory mode) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Agent Info (change per client) ──────────────────────────
AGENT_NAME=John Smith
AGENCY_NAME=Smith Realty Group
AGENT_PHONE=+1 (555) 765-4321
AGENT_EMAIL=john@smithrealty.com
AGENT_WEBSITE=https://smithrealty.com
AGENT_ADDRESS=123 Realtor Lane, Dallas, TX 75201
LISTINGS_URL=https://smithrealty.com/listings
GOOGLE_REVIEW=https://g.page/r/smithrealty/review
GOOGLE_MAPS=https://maps.google.com/?q=smithrealty

# ── Owner ────────────────────────────────────────────────────
OWNER_PHONE=+923366614025

# ── Server ───────────────────────────────────────────────────
PORT=3000
