# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Weather API ──────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_key

# ── Restaurant Info (US DEMO DATA — Mario's Italian Kitchen, Los Angeles) ──
# MUST be replaced with the real client's name/prices/hours before a client demo.
RESTAURANT_NAME=Mario's Italian Kitchen
RESTAURANT_ADDRESS=456 Oak Avenue, Los Angeles, CA 90001
RESTAURANT_PHONE=+1 (555) 987-6543
RESTAURANT_EMAIL=info@marios.com
RESTAURANT_WEBSITE=https://marios.com
RESTAURANT_HOURS=Mon–Sun: 11am–10pm
RESTAURANT_ZIP=90001

# ── Hours (24hr format) ──────────────────────────────────────
OPEN_HOUR=11
CLOSE_HOUR=22

# ── Capacity & Orders ────────────────────────────────────────
MAX_TABLES=20
MIN_ORDER=15
WAIT_TIME=20-30 mins
DELIVERY_ZIPS=90001,90002,90003,EC1A,EC2A

# ── Loyalty ──────────────────────────────────────────────────
LOYALTY_TARGET=10

# ── Social & Review Links ────────────────────────────────────
GOOGLE_REVIEW_URL=https://g.page/r/your-restaurant/review
FACEBOOK_URL=https://facebook.com/your-restaurant
INSTAGRAM_URL=https://instagram.com/your-restaurant

# ── Owner ────────────────────────────────────────────────────
OWNER_PHONE=+923366614025

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Supabase (optional — if unset, bot runs in demo in-memory mode) ──
# NOTE: This KEYWORD variant has no AI. No Groq/Gemini key is needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # optional; only if you need server-side writes beyond anon
