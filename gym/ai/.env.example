# ── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Gym Info (change per client) ────────────────────────────
GYM_NAME=FitLife Gym & Personal Training
GYM_ADDRESS=789 Fitness Avenue, New York, NY 10001
GYM_PHONE=+1 (555) 123-4567
GYM_EMAIL=info@fitlifegym.com
GYM_WEBSITE=https://fitlifegym.com
GYM_HOURS=Mon–Fri: 5am–11pm | Sat–Sun: 6am–9pm
GYM_INSTAGRAM=@fitlifegym

# ── Trainers ─────────────────────────────────────────────────
TRAINER_1=Coach Mike
TRAINER_2=Coach Sarah

# ── Membership Prices ────────────────────────────────────────
PRICE_BASIC=29
PRICE_PRO=49
PRICE_ELITE=99

# ── Loyalty (points needed for free month) ───────────────────
LOYALTY_TARGET=30

# ── Owner ────────────────────────────────────────────────────
OWNER_PHONE=+923366614025

# ── Storage: Supabase (both variants) ────────────────────────
# If these are left blank the bot runs in demo mode (in-memory only,
# data lost on restart). Set them for any real / paid use.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   (optional, use instead of ANON key on server)

# ── AI (AI variant only) ─────────────────────────────────────
# Groq free tier first, Gemini free tier as fallback.
# GROK_API_KEY is also accepted as a spelling fallback for GROQ_API_KEY
# (Groq, NOT xAI Grok — no xAI API is ever called).
# If no AI key is set, the bot falls back to keyword routing, never crashes.
# Nabil: add the real keys yourself in Vercel env vars — never paste keys
# in chat or in files.
GROQ_API_KEY=
GEMINI_API_KEY=
# GROK_API_KEY=   (alias for GROQ_API_KEY, same Groq free tier)

# ── Server ───────────────────────────────────────────────────
PORT=3000
