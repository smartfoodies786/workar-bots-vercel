# ── Supabase (storage for BOTH variants) ─────────────────────
# If left empty, the bot runs in demo mode: in-memory Maps only,
# data lost on restart. Set these in Vercel env vars to persist.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=3000

# NOTE (KEYWORD variant): no AI keys here. This variant needs no
