TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Store Info (change per client) ──────────────────────────
STORE_NAME=TrendShop USA
STORE_URL=https://trendshop.com
STORE_EMAIL=support@trendshop.com
STORE_PHONE=+1 (555) 123-4567
STORE_INSTAGRAM=@trendshopusa
STORE_FACEBOOK=facebook.com/trendshopusa

# ── Review Links ─────────────────────────────────────────────
GOOGLE_REVIEW=https://g.page/r/trendshop/review
TRUSTPILOT_URL=https://trustpilot.com/review/trendshop.com

# ── VIP & Loyalty Settings ────────────────────────────────────
VIP_THRESHOLD=500
CASHBACK_RATE=5

# ── Owner ────────────────────────────────────────────────────
OWNER_PHONE=+923366614025

# ── Supabase (storage for BOTH variants) ─────────────────────
# If left empty, the bot runs in demo mode: in-memory Maps only,
# data lost on restart. Set these in Vercel env vars to persist.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── AI (AI variant only — free tiers) ────────────────────────
# nabil adds these himself directly in Vercel env vars — never paste
# keys in chat or files. GROQ_API_KEY is tried first, then GEMINI_API_KEY.
# GROK_API_KEY is also accepted as a spelling alias for GROQ_API_KEY
# (Groq free tier, model gpt-oss-20b — NOT xAI Grok).
# If no key is set, the bot falls back to keyword routing, never crashes.
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Server ───────────────────────────────────────────────────
PORT=3000
